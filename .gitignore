# Fortran build artifacts (regenerated by compile.sh)
*.mod
*.o
*.exe
gmon.out

# MATLAB autosave / cache files
*.asv
*.mat

# Movies and images (regenerable analysis/movie output)
*.avi
*.png
*.jpg
*.jpeg

# Simulation output data is large and regenerable per-run -- keep only a
# small "initial" (it=50000, needed as the nrun=2 restart snapshot)
# mesh-state example for reference; ignore everything else (including the
# whole-run summary series, which can grow to tens of MB each over a long
# run).
data/*
!data/inn_00050000.dat
!data/num_00050000.dat
!data/v_00050000.dat
!data/motility_store.dat
